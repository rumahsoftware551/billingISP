APP_NAME=Jaringanku
APP_ENV=production
APP_KEY=CHANGE_ME_OR_USE_APP_KEY_FILE
APP_DEBUG=false
APP_URL=https://jaringanku.example.com
APP_PORT=8080
APP_BIND=127.0.0.1
APP_TIMEZONE=Asia/Jakarta
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=jaringanku
DB_USERNAME=jaringanku
DB_PASSWORD=CHANGE_ME_OR_USE_DB_PASSWORD_FILE
DB_SSLMODE=prefer

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
CACHE_LIMITER=redis
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis

SEED_ADMIN_NAME=Administrator Jaringanku
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_TENANT_NAME=Jaringanku ISP
SEED_TENANT_SLUG=jaringanku-isp
SEED_DEMO_DATA=false
PHASE3_DEMO_PPPOE_PASSWORD=DISABLED

RADIUS_HOST=radius
RADIUS_SHARED_SECRET=CHANGE_ME_OR_USE_RADIUS_SHARED_SECRET_FILE
RADIUS_TEST_PASSWORD=DISABLED
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_CLIENT_NETWORK=CHANGE_ME_MIKROTIK_IP_OR_CIDR

POSTGRES_VOLUME_NAME=jaringanku-postgres
REDIS_VOLUME_NAME=jaringanku-redis
STORAGE_VOLUME_NAME=jaringanku-storage
BACKUP_VOLUME_NAME=jaringanku-backups

MIKROTIK_VERIFY_TLS=true

PHASE4_ACCOUNTING_SMOKE=false
PHASE5_BILLING_SMOKE=false
PHASE6_AUTOMATION_SMOKE=false
PHASE7_REPORTS_SMOKE=false
PHASE8_PRODUCTION_SMOKE=false
PHASE9_PAYMENT_SMOKE=false
PHASE10_PORTAL_SMOKE=false
PHASE10_PORTAL_PASSWORD=DISABLED
PHASE11_OPERATIONS_SMOKE=false

FORCE_HTTPS=true
TRUSTED_PROXIES=*
HEALTH_TOKEN=CHANGE_ME_LONG_RANDOM_HEALTH_TOKEN
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=120
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
WEBHOOK_ALLOW_INSECURE_HTTP=false
WEBHOOK_USER_AGENT=Jaringanku-Webhook/1.0
WEBHOOK_RESPONSE_BODY_LIMIT=2048

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Jaringanku

BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# Phase 12 SaaS & Final Release
JARINGANKU_VERSION=1.2.0-dev
RELEASE_CHANNEL=development
SEED_PLATFORM_PLAN=PRO
PHASE12_FINAL_SMOKE=false
RELEASE_GIT_COMMIT=

# Phase 13 Portal Mitra
PHASE13_PARTNER_PASSWORD=DISABLED
PHASE13_PARTNER_SMOKE=false

PHASE14_INVENTORY_PASSWORD=DISABLED
PHASE14_INVENTORY_SMOKE=false

# Phase 15 Final Integration & Stable Release
PHASE15_FINAL_SMOKE=false

# Phase 16 commercial-readiness acceptance
PHASE16_COMMERCIAL_SMOKE=true
